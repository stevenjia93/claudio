# 复制本文件为 .env,填上你自己的 key 就能用
# .env 不会进 git,放心写真 key

# Anthropic — 必填
ANTHROPIC_API_KEY=sk-ant-api03-在这里贴

# ElevenLabs — 可选,不填会回落到浏览器原生 TTS(机器嗓)
ELEVENLABS_API_KEY=sk_在这里贴
ELEVENLABS_VOICE_ID=IRHApOXLvnW57QJPQH2P

# 国内访问 Anthropic 必须走代理 — Mac 一般不用,国内 Mac 也要
# v2rayN/Clash 默认端口示例
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890

# 想换模型(默认 sonnet 4.5,够用且便宜)
# CLAUDIO_MODEL=claude-opus-4-5

# —————— 音源 ——————
# 优先级,从左到右,主源拿不到自动 fallback。
# 默认只开网易, 想开 QQ + YT 改成: netease,qq,ytmusic
# MUSIC_SOURCES=netease,qq,ytmusic

# 网易云 — NeteaseCloudMusicApi (npx NeteaseCloudMusicApi)
# NCM_BASE=http://localhost:3000

# QQ 音乐 — 直接打 QQ 接口,不需要本地代理 server
# 免费曲不需要 cookie,VIP 曲要登录态:
#   1. 浏览器登录 https://y.qq.com
#   2. DevTools → Application → Cookies → https://y.qq.com
#   3. 复制 uin (数字) 和 qm_keyst,填到下面,或一步贴整个 Cookie 头
# QQ_UIN=
# QQ_QM_KEYST=
# QQ_COOKIE=uin=xxx; qm_keyst=xxx; ...

# YouTube Music — yt-dlp + cookie (按优先级,任选一种)
# YT_COOKIES_FROM_BROWSER=chrome    # 本地 Mac 最省事 (借浏览器登录态; chrome/safari/firefox/edge/brave)
# YT_COOKIES_FILE=/cookies.txt      # Docker 推荐 (用 -v 把 cookies.txt 挂进容器)
# YT_COOKIE=                        # 也可以手贴整段 cookie 头
# YT_DLP_BIN=yt-dlp                 # 自定义 yt-dlp 路径 (默认 PATH 找)
# 国内会自动走 HTTPS_PROXY (跟 Anthropic 共享代理)

# —————— 口味信号 (Spotify) ——————
# 把你 Spotify 的 Top Artists + Liked Songs 同步成本地 JSON
# 喂给 Claude 当口味画像。不用 Spotify 就留空。
#
# 怎么配:
#   1. https://developer.spotify.com/dashboard 创建 App
#   2. Redirect URI 必须填: http://127.0.0.1:3001/callback
#      (Spotify 现在不接受 localhost, 必须 127.0.0.1)
#   3. 拿 Client ID + Client Secret 填到下面
#   4. 跑一次: node scripts/spotify-auth.js
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
